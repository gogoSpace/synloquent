{
  "name": "synloquent/laravel",
  "description": "Explicit Eloquent exports, deterministic TypeScript generation and transactional offline synchronization",
  "version": "0.1.0",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "illuminate/auth": "^12.55 || ^13.34",
    "illuminate/console": "^12.55 || ^13.34",
    "illuminate/contracts": "^12.55 || ^13.34",
    "illuminate/database": "^12.55 || ^13.34",
    "illuminate/http": "^12.55 || ^13.34",
    "illuminate/routing": "^12.55 || ^13.34",
    "illuminate/support": "^12.55 || ^13.34",
    "illuminate/validation": "^12.55 || ^13.34",
    "opis/json-schema": "2.6.0"
  },
  "require-dev": {
    "laravel/framework": "13.34.0",
    "orchestra/testbench": "11.3.0",
    "phpunit/phpunit": "^12.5.8",
    "laravel/pint": "1.32.1",
    "phpstan/phpstan": "2.2.16",
    "larastan/larastan": "3.12.2"
  },
  "autoload": {
    "psr-4": {
      "Synloquent\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Synloquent\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Synloquent\\Laravel\\SynloquentServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "pint --test",
    "analyse": "phpstan analyse --memory-limit=1G"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "archive": {
    "exclude": [
      "vendor",
      "tests",
      ".phpstan.cache",
      ".phpunit.cache",
      ".phpunit.result.cache",
      "composer.lock",
      "phpunit.xml",
      "phpstan.neon",
      "pint.json"
    ]
  }
}
