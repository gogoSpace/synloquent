{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synloquent.local/protocol/1/relation.schema.json",
  "type": "object",
  "properties": {
    "oneOfMany": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "field": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "aggregate": { "enum": ["min", "max"] }
        },
        "required": ["field", "aggregate"],
        "additionalProperties": false
      }
    },
    "type": {
      "enum": [
        "belongsTo",
        "hasOne",
        "hasMany",
        "belongsToMany",
        "hasOneThrough",
        "hasManyThrough",
        "morphTo",
        "morphOne",
        "morphMany",
        "morphToMany",
        "morphedByMany",
        "ofMany",
        "latestOfMany",
        "oldestOfMany"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "pivot": {
      "type": "object",
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "foreignKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "relatedKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "field.schema.json"
          }
        }
      },
      "additionalProperties": false,
      "required": ["table", "foreignKey", "relatedKey", "fields"]
    },
    "morphMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "aggregate": {
      "enum": ["min", "max"]
    },
    "foreignKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "localKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "ownerKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "through": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "secondKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "morphType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "aggregateField": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "secondLocalKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "onDelete": {
      "enum": ["cascade", "restrict", "nullify"]
    },
    "onUpdate": {
      "enum": ["cascade", "restrict"]
    }
  },
  "additionalProperties": false,
  "required": ["type", "model"]
}
