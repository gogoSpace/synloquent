{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synloquent.local/protocol/1/snapshot.schema.json",
  "type": "object",
  "properties": {
    "schemaFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "generation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "byteSize": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "record.schema.json"
      },
      "maxItems": 500000
    },
    "scope": {
      "$ref": "scope.schema.json"
    },
    "relationSets": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "relation-set.schema.json"
      }
    },
    "downloadUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaFingerprint",
    "dataset",
    "generation",
    "cursor",
    "hash",
    "byteSize",
    "records",
    "scope",
    "relationSets"
  ]
}
