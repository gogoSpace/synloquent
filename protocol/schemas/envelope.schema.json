{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synloquent.local/protocol/1/envelope.schema.json",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "kind": {
      "enum": ["manifest", "query", "push", "pull", "snapshot", "command"]
    },
    "schemaFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "session": {
      "type": "object",
      "properties": {
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "tenantId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "deviceEpoch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "accountId",
        "tenantId",
        "deviceId",
        "deviceEpoch",
        "generation"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "requestId",
    "kind",
    "schemaFingerprint",
    "session",
    "payload"
  ]
}
