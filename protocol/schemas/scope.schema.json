{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synloquent.local/protocol/1/scope.schema.json",
  "type": "object",
  "properties": {
    "dataset": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "authorizationGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "projectionGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "schemaFingerprint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "completeness": {
      "enum": ["complete", "partial"]
    }
  },
  "additionalProperties": false,
  "required": [
    "dataset",
    "authorizationGeneration",
    "projectionGeneration",
    "schemaFingerprint"
  ]
}
