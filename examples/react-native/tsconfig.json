{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "customConditions": [
      "react-native"
    ],
    "types": [
      "react",
      "react-native"
    ],
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@op-engineering/op-sqlite": [
        "./node_modules/@op-engineering/op-sqlite/lib/typescript/src/index.d.ts"
      ],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ]
    }
  },
  "include": [
    "App.tsx",
    "backend.generated.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
