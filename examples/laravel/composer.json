{
  "name": "synloquent/example-laravel",
  "description": "Generic Synloquent catalog example",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "laravel/framework": "13.34.0",
    "synloquent/laravel": "0.1.0"
  },
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "synloquent/laravel",
        "version": "0.1.0",
        "type": "library",
        "license": "MIT",
        "require": {
          "php": "^8.3",
          "ext-json": "*",
          "ext-pdo": "*",
          "illuminate/auth": "^12.55 || ^13.34",
          "illuminate/console": "^12.55 || ^13.34",
          "illuminate/contracts": "^12.55 || ^13.34",
          "illuminate/database": "^12.55 || ^13.34",
          "illuminate/http": "^12.55 || ^13.34",
          "illuminate/routing": "^12.55 || ^13.34",
          "illuminate/support": "^12.55 || ^13.34",
          "illuminate/validation": "^12.55 || ^13.34",
          "opis/json-schema": "2.6.0"
        },
        "autoload": {
          "psr-4": {
            "Synloquent\\Laravel\\": "src/"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "Synloquent\\Laravel\\SynloquentServiceProvider"
            ]
          }
        },
        "dist": {
          "type": "zip",
          "url": "../../artifacts/packages/synloquent-laravel-0.1.0-b96bcf4c877892cd.zip",
          "shasum": "7bca658d38244e816851115823509cf4ab2b4c6a"
        }
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  }
}
