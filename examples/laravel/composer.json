{
  "name": "synloquent/example-laravel",
  "description": "Synthetic Synloquent Laravel host",
  "type": "project",
  "license": "MIT",
  "require": { "php": "^8.3", "laravel/framework": "13.34.0", "synloquent/laravel": "0.1.0" },
  "repositories": [{ "type": "path", "url": "../../packages/laravel", "options": { "symlink": true } }],
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" } },
  "config": { "sort-packages": true, "allow-plugins": {} },
  "scripts": { "post-autoload-dump": ["@php artisan package:discover --ansi"] }
}
